---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts, groupByYear, postUrl } from '../../lib/posts';
import { formatDate, isoDate } from '../../lib/utils';

const posts = await getPosts();
const years = groupByYear(posts);
---

<BaseLayout title="전체 글" description={`지금까지 작성한 ${posts.length}개의 글을 연도별로 정리했습니다.`}>
  <PageHeader title="전체 글" description={`지금까지 작성한 ${posts.length}개의 글입니다.`} />

  {
    years.map(([year, list]) => (
      <section class="archive-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="archive-year-title">
          {year}
          <span class="count">{list.length}</span>
        </h2>
        <ul class="archive-list">
          {list.map((post) => (
            <li>
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date).slice(6)}</time>
              <a href={postUrl(post)}>{post.data.title}</a>
              <span class="archive-category">{post.data.category}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  {posts.length === 0 && <p class="empty-state">아직 작성된 글이 없습니다.</p>}
</BaseLayout>
