---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAdjacentPosts, getPosts, getRelatedPosts, type Post } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      ...getAdjacentPosts(posts, post),
      related: getRelatedPosts(posts, post),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
  related: Post[];
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout post={post} headings={headings} prev={prev} next={next} related={related}>
  <Content />
</BlogPostLayout>
