---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { getCategories, getPosts, type Post } from '../../lib/posts';
import { slugify } from '../../lib/utils';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return getCategories(posts).map((category) => ({
    params: { category: category.slug },
    props: {
      name: category.name,
      posts: posts.filter((post) => slugify(post.data.category) === category.slug),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`${name} 카테고리`} description={`${name} 카테고리의 글 ${posts.length}개를 최신순으로 보여줍니다.`}>
  <PageHeader eyebrow="Category" title={name} description={`${posts.length}개의 글`} />
  <PostList posts={posts} />
</BaseLayout>
