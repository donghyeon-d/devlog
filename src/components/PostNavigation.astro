---
import { postUrl, type Post } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  prev?: Post;
  next?: Post;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="post-nav" aria-label="이전 글 / 다음 글" data-pagefind-ignore>
      {prev ? (
        <a href={postUrl(prev)} class="post-nav-link post-nav-prev" rel="prev">
          <span class="post-nav-label">
            <Icon name="arrow-left" size={14} /> 이전 글
          </span>
          <span class="post-nav-title">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={postUrl(next)} class="post-nav-link post-nav-next" rel="next">
          <span class="post-nav-label">
            다음 글 <Icon name="arrow-right" size={14} />
          </span>
          <span class="post-nav-title">{next.data.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
